{
  "name": "gtip-learning-system",
  "private": true,
  "version": "0.1.0",
  "description": "Gümrük mevzuatı kaynak yönetimi ve GTIP öğrenme platformu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gtip/shared && npm run build --workspace @gtip/api && npm run build --workspace @gtip/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @gtip/api",
    "dev:web": "npm run dev --workspace @gtip/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:fix": "eslint . --fix",
    "start": "NODE_ENV=production SERVE_WEB=true node apps/api/dist/index.js",
    "preview": "npm run build && npm start"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.68.0"
  }
}
