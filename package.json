{
  "name": "gtip-learning-system",
  "private": true,
  "version": "0.1.0",
  "description": "G\u00fcmr\u00fck mevzuat\u0131 kaynak y\u00f6netimi ve GTIP \u00f6\u011frenme platformu",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace @gtip/shared && npm run build --workspace @gtip/api && npm run build --workspace @gtip/web",
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @gtip/api",
    "dev:web": "npm run dev --workspace @gtip/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "typescript-eslint": "^8.68.0"
  }
}
