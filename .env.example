# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_PORT=3000
API_BASE_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

# Bootstrap admin account, created on first start when no user exists.
ADMIN_EMAIL=admin@gumrukdoktoru.com
ADMIN_PASSWORD=change-me-too
ADMIN_DISPLAY_NAME=Sistem Yöneticisi

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# "local" writes to STORAGE_LOCAL_ROOT, "s3" writes to AWS_S3_BUCKET.
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage-data/objects

# Every object key is prefixed with this value.
#   public files  -> {AWS_FOLDER_PREFIX}public/uploads/{timestamp}-{fileName}
#   private files -> {AWS_FOLDER_PREFIX}uploads/{timestamp}-{fileName}
AWS_FOLDER_PREFIX=69655/

AWS_REGION=eu-central-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Lifetime (seconds) of signed URLs handed out for private files.
AWS_SIGNED_URL_TTL=300

# Upload limits
MAX_UPLOAD_SIZE_BYTES=26214400

# ---------------------------------------------------------------------------
# Learning hub (public page)
# ---------------------------------------------------------------------------
SITE_TITLE=Gümrük Doktoru Akademi
SITE_TAGLINE=Videolar, gönderiler ve belgeler tek sayfada; öğrenciler için derlenmiş çalışma kaynakları.

# YouTube: channel id (UC...), @handle, or a channel URL. No API key needed —
# the public Atom feed is used. Leave empty to hide the video shelf.
YOUTUBE_CHANNEL=@kullaniciadiniz
# How long a synced shelf stays fresh before a public read refreshes it.
YOUTUBE_SYNC_INTERVAL_MINUTES=30

# Instagram posts are added by hand from the admin panel (paste the post URL).
# This is only the "profili gör" link in the page header.
INSTAGRAM_PROFILE_URL=https://www.instagram.com/kullaniciadiniz/

# ---------------------------------------------------------------------------
# Persistence (file-backed repository; see README for the Postgres/Prisma path)
# ---------------------------------------------------------------------------
DATA_DIR=./storage-data/db

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:3000/api/v1
