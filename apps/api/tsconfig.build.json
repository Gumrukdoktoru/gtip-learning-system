{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    // Resolve @gtip/shared from its built package instead of its sources, so
    // the emitted JavaScript keeps the bare specifier Node can follow.
    "paths": {}
  },
  "include": ["src/**/*"],
  "exclude": ["src/**/*.test.ts"]
}
